{
  "name": "tokers-pc",
  "productName": "Toker's",
  "version": "1.0.0",
  "description": "Toker's — la herramienta perfecta para el Artista",
  "author": "Salomón",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.tokers.dibujo",
    "productName": "Toker's",
    "copyright": "Toker's",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "www/**/*", "!www/sw.js"],
    "win": { "icon": "build/icon.png", "target": ["portable", "zip"] },
    "portable": { "artifactName": "Tokers-Portable.exe", "requestExecutionLevel": "user" },
    "zip": { "artifactName": "Tokers-PC-carpeta.zip" },
    "compression": "maximum",
    "asar": true
  }
}
